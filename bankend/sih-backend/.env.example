# Environment Configuration
# Copy to .env and modify values as needed

# API Configuration
DEBUG=False
API_V1_STR=/api/v1

# Database
DATABASE_URL=mongodb://admin:password@localhost:27017/bovine_mastitis?authSource=admin

# Security
SECRET_KEY=your-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://10.250.43.53:3000","http://10.250.43.53:3001","http://localhost:3000","http://localhost:3001"]

# File Storage
MEDIA_DIR=./media

# ── MQTT Bridge ─────────────────────────────────────────────────────────────
# Set MQTT_ENABLED=true to start the hardware → backend bridge at server startup.
# The bridge subscribes to godrishti/+/sensors and forwards every ESP8266
# payload to POST /api/v1/ingest/esp8266 (existing unauthenticated endpoint).
#
# Device mapping must be registered first via:
#   POST /api/v1/devices/register  {"device_id": "ESP8266-COW-001", "tag_id": "F01_COW_001"}
#
MQTT_ENABLED=true
MQTT_BROKER_HOST=192.168.1.8
MQTT_BROKER_PORT=1884
# Leave blank for anonymous Mosquitto brokers (default local setup)
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=godrishti-backend-bridge
MQTT_TOPIC=godrishti/+/sensors
MQTT_RECONNECT_DELAY=5
DEV_FALLBACK_FARM_ENABLED=true
DEV_FALLBACK_FARM_NAME=Anand Demo Dairy Cluster
DEV_FALLBACK_FARM_CODE=ANAND-DEV
