# ============================================================
# INNOVX — Bovine Mastitis Early Forecasting
# Environment Configuration Template
# ============================================================

# Backend API base URL (no trailing slash)
# Local development:
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to force Demo Mode (uses localStorage mock data)
# Leave empty or "false" to use the live backend
VITE_DEMO_MODE=false

# ---- Legacy / AI Studio keys (keep if Gemini features are used) ----
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
